<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CsVelocityFlow.Application.ViewModels"
             xmlns:views="clr-namespace:CsVelocityFlow.Application.Views"
             xmlns:viewModels="clr-namespace:CsVelocityFlow.Application.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CsVelocityFlow.Application.Views.MainView"
             x:DataType="viewModels:MainViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#2b2b2b" Spacing="10">
            <Button Content="Widok Tabeli" 
                    Command="{Binding ShowTableViewCommand}" 
                    Padding="10,5" Background="#3c3c3c" Foreground="White"/>
            <Button Content="Widok Opcji (Checkbox)" 
                    Command="{Binding ShowCheckboxViewCommand}" 
                    Padding="10,5" Background="#3c3c3c" Foreground="White"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}" Margin="15"/>
    </DockPanel>
    
</UserControl>
