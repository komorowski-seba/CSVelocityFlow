<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CsVelocityFlow.Application.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CsVelocityFlow.Application.Views.MainView"
             x:DataType="viewModels:MainViewModel">

    <DockPanel>
        <SplitView IsPaneOpen="{Binding IsMenuOpen}"
                   DisplayMode="CompactInline"
                   OpenPaneLength="200"
                   CompactPaneLength="50"
                   Background="#1e1e1e"
                   PaneBackground="#2b2b2b">
            
            <SplitView.Pane>
                <StackPanel Spacing="5" Margin="5">
                    <Button Command="{Binding ShowCheckboxViewCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,10" Background="Transparent" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" VerticalAlignment="Center"/>
                            <TextBlock Text="Widok Tabeli" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowTableViewCommand}" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,10" Background="Transparent" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="☑️" VerticalAlignment="Center"/>
                            <TextBlock Text="Widok Opcji" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </SplitView.Pane>

            <Grid Background="#1e1e1e">
                <ContentControl Content="{Binding CurrentView}" Margin="15"/>
            </Grid>
        </SplitView>
    </DockPanel>
    
    
</UserControl>
